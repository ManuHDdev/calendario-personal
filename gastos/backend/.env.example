# Puerto HTTP del backend (por defecto 3005 si no se define)
PORT=3005

# PostgreSQL — base de datos propia "gastos" (mismo servidor que mapacyd, ver design.md)
GASTOS_DB_HOST=localhost
GASTOS_DB_NAME=gastos
GASTOS_DB_USER=gastos
GASTOS_DB_PASSWORD=changeme
GASTOS_DB_PORT=5432

# Keycloak - verificacion JWT (RS256 via JWKS), mismo realm "calendario" que el resto de subapps
KEYCLOAK_CERTS_URL=http://localhost:8080/realms/calendario/protocol/openid-connect/certs

# CORS - origenes permitidos, separados por comas
CORS_ORIGIN=http://localhost:5177

# Ruta donde se guardan las imagenes de tickets/capturas bancarias recibidas por Telegram
GASTOS_IMAGES_PATH=./data/images

# Bot de Telegram (@BotFather) - ver README para el paso manual de creacion
TELEGRAM_BOT_TOKEN=
# chat.id numerico del propietario; cualquier otro remitente es ignorado sin respuesta
TELEGRAM_OWNER_CHAT_ID=
