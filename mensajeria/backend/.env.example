# Base de datos
MENSAJERIA_DB_HOST=localhost
MENSAJERIA_DB_NAME=mensajeria
MENSAJERIA_DB_USER=mensajeria
MENSAJERIA_DB_PASSWORD=changeme
MENSAJERIA_DB_PORT=5444

# Keycloak / CORS
KEYCLOAK_CERTS_URL=http://localhost:8080/realms/calendario/protocol/openid-connect/certs
CORS_ORIGIN=http://localhost:5188

# Servidor
PORT=3015

# Modo mock/real (interruptor explicito, nunca se autodetecta)
MENSAJERIA_MODE=mock

# SMTP falso en proceso (modo mock, siempre disponible, coste cero)
MENSAJERIA_SMTP_PORT=2525

# SMS/llamada real (Twilio) - las tres son necesarias para activar el canal real,
# si falta alguna ese canal se queda en mock en silencio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email real (SendGrid) - ambas necesarias para activar el canal real
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=