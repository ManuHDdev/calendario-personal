{
  "name": "locales-backend",
  "version": "1.0.0",
  "description": "Locales backend — rastreador de locales comerciales y farmacias en venta con verificación de distancia peatonal (Fastify + Keycloak JWT + PostgreSQL + Telegram)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "ts-node --transpile-only src/smoke.ts",
    "padron": "ts-node --transpile-only src/padron/cli.ts",
    "telegram:chat-id": "ts-node --transpile-only src/chatId.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.28.1",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.11.5",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "picomatch": "^4.0.5"
  }
}
