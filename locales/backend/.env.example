# Copia esto a .env para desarrollo local. En produccion las variables las
# inyecta docker-compose desde /home/manu/locales/.env (ver DEPLOY_NOTES.md).

# --- Base de datos -----------------------------------------------------------
LOCALES_DB_HOST=localhost
LOCALES_DB_NAME=locales
LOCALES_DB_USER=locales
LOCALES_DB_PASSWORD=locales123
LOCALES_DB_PORT=5442

# --- Auth y red --------------------------------------------------------------
KEYCLOAK_CERTS_URL=http://localhost:8080/keycloak/realms/calendario/protocol/openid-connect/certs
CORS_ORIGIN=http://localhost:5185
PORT=3013

# --- Motor de distancias peatonales ------------------------------------------
# `ors` no necesita nada mas que la clave (la misma que usan paraisos y ruta).
# `valhalla` necesita la instancia propia levantada (perfil `valhalla` del
# compose de produccion) y no tiene cuota.
LOCALES_MOTOR_DISTANCIA=ors

# OJO: el endpoint de MATRIZ de ORS tiene una cuota mas baja que el de
# direcciones. Por eso el presupuesto va aparte y por defecto en 400.
ORS_API_KEY=
LOCALES_PRESUPUESTO_RUTAS_DIARIO=400
VALHALLA_URL=http://localhost:8002

# --- Fuentes del padron -------------------------------------------------------
# Instancia de Overpass. La publica va bien pero se satura; si da 429/504 de
# forma habitual, apunta a otra.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Recurso CSV del registro oficial de farmacias de la Comunidad de Madrid.
# Si el portal cambia la URL del recurso, se sobreescribe aqui sin tocar codigo.
LOCALES_DATASET_MADRID=
# Nominatim exige identificarse. Deja el valor por defecto o pon el tuyo.
NOMINATIM_USER_AGENT=

# --- Telegram (opcional) ------------------------------------------------------
# Sin estas dos la app funciona igual, solo se queda sin avisos ni consultas
# desde el movil, y lo dice en el log al arrancar.
# `npm run telegram:chat-id` para leer tu chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
