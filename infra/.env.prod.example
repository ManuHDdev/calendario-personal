# PostgreSQL
POSTGRES_USER=calendariodb
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_DB

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD_KC_ADMIN
