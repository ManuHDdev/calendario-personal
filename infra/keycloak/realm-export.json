{
  "realm": "calendario",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "PROPIETARIO",
        "description": "Propietario del calendario personal",
        "composite": false,
        "clientRole": false,
        "containerId": "calendario"
      }
    ],
    "client": {
      "calendario-frontend": [],
      "calendario-backend": []
    }
  },
  "clients": [
    {
      "clientId": "calendario-frontend",
      "name": "Calendario Frontend",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200",
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "calendario-backend",
      "name": "Calendario Backend",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "secret": "calendario-backend-secret",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "propietario",
      "email": "propietario@calendario.local",
      "firstName": "Propietario",
      "lastName": "Calendario",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "propietario123",
          "temporary": true
        }
      ],
      "realmRoles": [
        "PROPIETARIO",
        "default-roles-calendario"
      ],
      "clientRoles": {}
    }
  ],
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "scopeMappings": [],
  "clientScopeMappings": {}
}
