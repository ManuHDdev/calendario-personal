{
  "name": "vine-resenas-backend",
  "version": "1.0.0",
  "description": "Vine reviews backend: per-product photos/video, feedback, stars and state, plus a bearer-token API for Claude (Fastify + Keycloak JWT + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "import:legacy": "node dist/scripts/import.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "fastify": "^4.28.1",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "picomatch": "^4.0.5"
  }
}
